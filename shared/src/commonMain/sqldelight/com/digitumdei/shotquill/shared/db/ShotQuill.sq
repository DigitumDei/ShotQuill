-- A photo on the phone that a post uses.
CREATE TABLE media_assets (
  id TEXT NOT NULL PRIMARY KEY,
  uri TEXT NOT NULL,
  mime_type TEXT,
  width_px INTEGER,
  height_px INTEGER,
  created_at_epoch_millis INTEGER NOT NULL
);

-- A post: its words and where it has got to. How the photo is framed and
-- where the post was published are kept outside the database, per post.
CREATE TABLE post_drafts (
  id TEXT NOT NULL PRIMARY KEY,
  format TEXT NOT NULL,
  status TEXT NOT NULL,
  caption_text TEXT,
  alt_text TEXT,
  created_at_epoch_millis INTEGER NOT NULL,
  updated_at_epoch_millis INTEGER NOT NULL
);

CREATE TABLE post_draft_media_items (
  draft_id TEXT NOT NULL REFERENCES post_drafts(id) ON DELETE CASCADE,
  media_asset_id TEXT NOT NULL REFERENCES media_assets(id) ON DELETE CASCADE,
  media_order INTEGER NOT NULL,
  PRIMARY KEY (draft_id, media_asset_id),
  UNIQUE (draft_id, media_order)
);

-- Saving a row is two statements, an insert that does nothing when the row
-- is already there and then an update, rather than one "ON CONFLICT DO
-- UPDATE". That form needs SQLite 3.24, which phones before Android 11 do not
-- have.

insertMediaAssetIfNew:
INSERT OR IGNORE INTO media_assets(
  id,
  uri,
  mime_type,
  width_px,
  height_px,
  created_at_epoch_millis
) VALUES (?, ?, ?, ?, ?, ?);

updateMediaAsset:
UPDATE media_assets
SET uri = ?,
    mime_type = ?,
    width_px = ?,
    height_px = ?,
    created_at_epoch_millis = ?
WHERE id = ?;

selectMediaAssetUriById:
SELECT uri FROM media_assets WHERE id = ?;

deleteMediaAssetIfUnused:
DELETE FROM media_assets
WHERE id = :id
  AND NOT EXISTS (SELECT 1 FROM post_draft_media_items WHERE media_asset_id = :id);

insertPostDraftIfNew:
INSERT OR IGNORE INTO post_drafts(
  id,
  format,
  status,
  caption_text,
  alt_text,
  created_at_epoch_millis,
  updated_at_epoch_millis
) VALUES (?, ?, ?, ?, ?, ?, ?);

updatePostDraft:
UPDATE post_drafts
SET format = ?,
    status = ?,
    caption_text = ?,
    alt_text = ?,
    created_at_epoch_millis = ?,
    updated_at_epoch_millis = ?
WHERE id = ?;

selectPostDraftById:
SELECT * FROM post_drafts WHERE id = ?;

selectAllPostDrafts:
SELECT pd.id, pd.status, pd.caption_text, pd.created_at_epoch_millis, pd.updated_at_epoch_millis, ma.uri AS primary_media_uri
FROM post_drafts pd
LEFT JOIN post_draft_media_items pdmi ON pdmi.draft_id = pd.id AND pdmi.media_order = 0
LEFT JOIN media_assets ma ON ma.id = pdmi.media_asset_id
ORDER BY pd.updated_at_epoch_millis DESC;

deletePostDraftById:
DELETE FROM post_drafts WHERE id = ?;

deletePostDraftMediaItems:
DELETE FROM post_draft_media_items WHERE draft_id = ?;

insertPostDraftMediaItem:
INSERT INTO post_draft_media_items(draft_id, media_asset_id, media_order)
VALUES (?, ?, ?);

selectPostDraftMediaAssetIds:
SELECT media_asset_id FROM post_draft_media_items WHERE draft_id = ?;

selectPostDraftMediaItems:
SELECT media_assets.*, post_draft_media_items.media_order
FROM post_draft_media_items
JOIN media_assets ON media_assets.id = post_draft_media_items.media_asset_id
WHERE post_draft_media_items.draft_id = ?
ORDER BY post_draft_media_items.media_order ASC;
