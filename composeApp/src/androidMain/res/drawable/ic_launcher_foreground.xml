<?xml version="1.0" encoding="utf-8"?>
<!-- A quill crossing a photo's crop corners. Everything sits inside the middle
     66 of the 108 units, which is the part every launcher shape keeps. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Crop corners -->
    <path
        android:pathData="M31,43 V31 H43"
        android:strokeColor="#F1E9DC"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M77,65 V77 H65"
        android:strokeColor="#F1E9DC"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Shaft and nib -->
    <path
        android:pathData="M56,52 L35,75"
        android:strokeColor="#E9B44C"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
    <!-- Feather -->
    <path
        android:pathData="M77,29 C59,29 45,42 43,64 C47,65 51,63 54,60 C56,61 59,60 61,57 C63,58 66,56 68,53 C70,53 72,51 73,48 C76,43 77,36 77,29 Z"
        android:fillColor="#E9B44C" />
    <!-- Spine -->
    <path
        android:pathData="M72,34 L48,59"
        android:strokeColor="#12100E"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>
