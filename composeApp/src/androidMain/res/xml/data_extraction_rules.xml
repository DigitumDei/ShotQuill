<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone by backup or by copying to a new phone. The saved
     keys and tokens are encrypted with a key that never leaves this phone, so a
     copy of them would be unreadable anywhere else. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
